{
  "manifest_version": 3,
  "name": "Chinese Manga Reader",
  "version": "0.1",
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions" : ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
    },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["pinyin-pro.js", "content.js"]
    }
  ]
}